{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=fitcoach-ai",
  "outputDirectory": "fitcoach-ai/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
